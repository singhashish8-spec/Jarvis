# ============================================
# JARVIS ENVIRONMENT VARIABLES
# ============================================
# This file is a TEMPLATE.
# Copy it to `.env` and fill in your real values.
# NEVER commit the actual `.env` file — it holds secrets.
#
# How to get each value? See docs/GETTING_STARTED.md
# ============================================

# ------------------------------------------------
# REPLICATE API (cloud AI models — used from Phase 1)
# ------------------------------------------------
# Get it: https://replicate.com -> Settings -> API tokens
REPLICATE_API_KEY=your_replicate_api_key_here

# Replicate has no API for real account balance/credit, so the dashboard's
# usage widget tracks estimated spend against a budget YOU set here —
# match it to what you've actually loaded at replicate.com/account/billing.
# Leave unset to hide the credit bar (tokens/spend still show either way).
REPLICATE_CREDIT_LIMIT_USD=

# $/second used to estimate cost for models Replicate bills by compute
# time rather than tokens (see docs/API_SPEC.md). Defaults to Replicate's
# published Nvidia A100 (80GB) rate if left unset.
REPLICATE_GPU_RATE_PER_SECOND=0.0014

# ------------------------------------------------
# SUPABASE (database)
# ------------------------------------------------
# Get it: https://supabase.com -> Project -> Settings -> API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------
# CLOUDFLARE R2 (file storage, S3-compatible)
# ------------------------------------------------
# Get it: Cloudflare dashboard -> R2 -> Manage API tokens
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=jarvis-data
CLOUDFLARE_R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# ------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# ------------------------------------------------
# SERVER SETTINGS
# ------------------------------------------------
HOST=0.0.0.0
PORT=5000

# ------------------------------------------------
# SECURITY
# ------------------------------------------------
# Any random string works locally. Generate a strong one for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_string
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------
FEATURE_BRAINSTORM_AGENT=True
FEATURE_CODER_AGENT=False
FEATURE_TEST_AGENT=False
